rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net — Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ewilliamhe@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(id) {
      return id is string && id.size() == 10 && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidCovenant(val) {
      return val is string && val in ['Solari', 'Terra', 'Aether', 'Umbri'];
    }

    // 3. Entity Validation Blueprints (called on both create and update)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'covenant',
          'playerId',
          'photoUrl',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'covenant',
          'playerId',
          'photoUrl',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 40
        && isValidCovenant(data.covenant)
        && data.playerId is string
        && data.playerId.size() >= 6 && data.playerId.size() <= 64
        && data.playerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.photoUrl is string
        && data.photoUrl.size() <= 512
        && data.role is string
        && data.role == 'warden'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyQuestDoc(data, questDate) {
      return data.keys().hasAll([
          'ownerId',
          'dateKey',
          'tapsCompleted',
          'upgradesCompleted',
          'duelsCompleted',
          'blocksAnchored',
          'claimedQuestIds',
          'streakCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'dateKey',
          'tapsCompleted',
          'upgradesCompleted',
          'duelsCompleted',
          'blocksAnchored',
          'claimedQuestIds',
          'streakCount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.dateKey is string
        && data.dateKey == questDate
        && data.tapsCompleted is int && data.tapsCompleted >= 0 && data.tapsCompleted <= 100000
        && data.upgradesCompleted is int && data.upgradesCompleted >= 0 && data.upgradesCompleted <= 10000
        && data.duelsCompleted is int && data.duelsCompleted >= 0 && data.duelsCompleted <= 1000
        && data.blocksAnchored is int && data.blocksAnchored >= 0 && data.blocksAnchored <= 1000
        && data.claimedQuestIds is list
        && data.claimedQuestIds.size() <= 6
        && data.claimedQuestIds.hasOnly([
          'dq_channel_nodes',
          'dq_upgrade_entity',
          'dq_nexus_duel',
          'dq_anchor_block'
        ])
        && (data.claimedQuestIds.size() == 0 || data.claimedQuestIds[0] is string)
        && data.streakCount is int && data.streakCount >= 0 && data.streakCount <= 3650
        && data.status is string
        && data.status in ['active', 'all_claimed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Server-Managed Admin Registry (no client writes)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    // 5. Authenticated Warden Profiles (PII-isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && userId == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'covenant',
              'playerId',
              'photoUrl',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // 6. Subcollection: Daily Quests (Master Gate verifies parent /users/{userId} exists)
      match /dailyQuests/{questDate} {
        allow get: if isValidId(userId)
          && isValidDateId(questDate)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isVerifiedUser()
          && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidDateId(questDate)
          && isValidDailyQuestDoc(incoming(), questDate)
          && userId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidDateId(questDate)
          && isValidDailyQuestDoc(incoming(), questDate)
          && (
            isAdmin() || (
              isOwner(userId)
              && existing().status != 'all_claimed'
              && incoming().ownerId == existing().ownerId
              && incoming().dateKey == existing().dateKey
              && incoming().createdAt == existing().createdAt
              && incoming().updatedAt == request.time
              && exists(/databases/$(database)/documents/users/$(userId))
              && (
                // Action: Progress Increment
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'tapsCompleted',
                  'upgradesCompleted',
                  'duelsCompleted',
                  'blocksAnchored',
                  'updatedAt'
                ]) ||
                // Action: Claim Daily Quest Reward
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'claimedQuestIds',
                  'streakCount',
                  'status',
                  'updatedAt'
                ])
              )
            )
          );

        allow delete: if isValidId(userId) && isValidDateId(questDate) && isAdmin();
      }
    }
  }
}
