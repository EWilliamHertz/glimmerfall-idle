# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Secret passcode for the hidden /admin developer analytics panel.
# Set this in your deployment Secrets panel or local .env (never commit secrets).
ADMIN_PASSWORD=""

# Vercel Blob storage for raw GlimmerFall Entity artwork (server-side only).
# Configure these in Settings -> Secrets or local .env (never commit live tokens).
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
